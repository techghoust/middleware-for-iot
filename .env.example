MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPICS=home/#

HTTP_PORT=3000
WEBSOCKET_PORT=3002

LOG_LEVEL=info

DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_MAX_EVENTS=500
DIAGNOSTICS_MAX_CONNECTIONS=1000

# disabled by default; enable explicitly or use the diagnostics UI
SANDBOX_ENABLED=false
SANDBOX_LATENCY_MS=0
SANDBOX_LOSS_RATE=0
SANDBOX_TIMEOUT_MS=0

WEBHOOK_URL=http://localhost:3001/events
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=500
DEAD_LETTER_PATH=data/dead-letters.jsonl
